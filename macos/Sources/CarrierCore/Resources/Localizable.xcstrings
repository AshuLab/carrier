    "alertStopMessage %lld": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@running@"
          },
          "substitutions": {
            "running": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg epic will be interrupted. It resumes on the next start, but what it was doing right now is lost."
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg epics will be interrupted. They resume on the next start, but what they were doing right now is lost."
                    }
                  }
                }
              }
            }
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@running@"
          },
          "substitutions": {
            "running": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "Se interrumpirá %arg epic. Se reanuda en el próximo inicio, pero lo que estaba haciendo ahora mismo se pierde."
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "Se interrumpirán %arg epics. Se reanudan en el próximo inicio, pero lo que estaban haciendo ahora mismo se pierde."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
