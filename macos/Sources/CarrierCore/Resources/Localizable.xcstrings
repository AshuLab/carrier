                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": ", que va %arg commit por detrás de %4$@"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": ", que va %arg commits por detrás de %4$@"
