    "piecesHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every piece of the app in the states its catalog entry lists, drawn with made-up data. Point at a piece and press it to see its hover and pressed states. To see this page in Spanish, open Carrier Dev again with -AppleLanguages (es)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada pieza de la app en los estados que lista su entrada del catálogo, dibujada con datos inventados. Apunta a una pieza y púlsala para ver cómo se ve al pasar el puntero y al pulsarla. Para ver esta página en inglés, abre Carrier Dev de nuevo con -AppleLanguages (en)."
          }
        }
      }
    },
