    "projectsCleanUpQuestionWords": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Their folders go, with what git ignores in them. Their branches and their sessions stay, and a session's next message brings its folder back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus carpetas se van, con lo que git ignora en ellas. Sus ramas y sus sesiones se quedan, y el siguiente mensaje de una sesión le devuelve su carpeta."
          }
        }
      }
    },
