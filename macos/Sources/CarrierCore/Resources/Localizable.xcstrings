          }
        }
      }
    },
    "sessionsSettingsFirstProviderShort": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First that can work"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El primero que pueda"
          }
        }
      }
    },
    "sessionsSettingsIdleFooter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An idle session you do not open for this long puts its agent to sleep, which frees its memory. It stays in the list, and a message wakes it where it left off. The session you have open stays awake, and so does one that is working or waiting for you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una sesión inactiva que no abres durante este tiempo duerme a su agente, lo que libera su memoria. Sigue en la lista, y un mensaje la despierta donde se quedó. La sesión que tienes abierta sigue despierta, igual que una que está trabajando o esperándote."
          }
        }
      }
    },
    "sessionsSettingsIdleSessions": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Idle sessions"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesiones inactivas"
          }
        }
      }
    },
    "sessionsSettingsLeftAlone": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Left alone"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si se deja en paz"
          }
        }
      }
    },
    "sessionsSettingsLeftAloneDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A session that is working, waiting for you or open is looked at again later"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una sesión que está trabajando, esperándote o abierta se vuelve a mirar más tarde"
          }
        }
      }
    },
    "sessionsSettingsNever": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Never"
          }
        },
        "es": {
