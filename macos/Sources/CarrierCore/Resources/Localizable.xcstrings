      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The agent changed from %1$@ to %2$@. %2$@ goes on from a selection of the messages above and can read the rest; reasoning and tool results did not carry over."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El agente cambió de %1$@ a %2$@. %2$@ continúa desde una selección de los mensajes de arriba y puede leer el resto; el razonamiento y los resultados de herramientas no se trasladaron."
          }
        }
      }
    },
