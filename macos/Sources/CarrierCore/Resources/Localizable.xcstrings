    "sessionsSettingsArchiveAndDelete": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Archive and delete"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivar y eliminar"
          }
        }
      }
    },
    "sessionsSettingsArchiveFooter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ages count from a session’s last activity. Delete is off while Archive is Never. Deleting removes the session’s worktree; work that is not saved is kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las edades cuentan desde la última actividad de una sesión. Eliminar está desactivado mientras Archivar sea Nunca. Eliminar quita el worktree de la sesión; el trabajo que no está guardado se conserva."
          }
        }
      }
    },
    "sessionsSettingsAskBeforeDeleting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask before deleting a session"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Preguntar antes de eliminar una sesión"
          }
        }
      }
    },
    "sessionsSettingsAskBeforeDeletingDetail": {
      "extractionState": "manual",
