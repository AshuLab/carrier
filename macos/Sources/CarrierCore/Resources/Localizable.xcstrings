    "text.recover.agentAlive": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An agent of the epic is alive or about to start, so nothing was changed. If the epic does not move, try again in a moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un agente del epic está vivo o a punto de empezar, así que no se cambió nada. Si el epic no avanza, inténtalo de nuevo en un momento."
          }
        }
      }
    },
    "text.recover.engineUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Carrier is stopping, still recovering its epics at start, or cannot act now (its agent profile was rejected), so nothing changed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Carrier se está deteniendo, aún recupera sus epics al arrancar o no puede actuar ahora (se rechazó su perfil de agente), así que no cambió nada."
          }
        }
      }
    },
    "text.recover.notRunning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The epic is not running, so there is nothing to recover. An epic that stopped for a person is resumed with carrier restart."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El epic no se está ejecutando, así que no hay nada que recuperar. Un epic que se detuvo por una persona se reanuda con carrier restart."
          }
        }
      }
    },
    "text.recover.notStarted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The epic has not started its first stage yet: the next check launches it."
          }
