    "fixtureSampleAgentMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I added a retry to `upload` that tries three times with a short pause between them, and a test that fails twice before it passes. The width of a message is how far a line runs before it wraps: a narrow column is easy on the eye, and a wide one fits more of a table or a long command, like `pnpm test && pnpm typecheck`."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agregué un reintento a `upload` que lo intenta tres veces con una breve pausa entre ellas, y una prueba que falla dos veces antes de pasar. El ancho de un mensaje es lo que mide una línea antes de partirse: una columna estrecha es cómoda para leer, y una ancha deja ver más de cada tabla o comando largo, como `pnpm test && pnpm typecheck`."
          }
        }
      }
    },
    "fixtureSampleUserMessage": {
      "extractionState": "manual",
