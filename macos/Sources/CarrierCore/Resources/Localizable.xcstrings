    "text.resume.didNotRestart": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The epic did not restart"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El epic no se reinició"
          }
        }
      }
    },
    "text.resume.extraRoundsNeedReviewLimit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "--extra-rounds grants rounds to an epic that stopped on the review limit, and this epic stopped for another reason."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "--extra-rounds concede rondas a un epic que se detuvo por el límite de revisión, y este epic se detuvo por otro motivo."
          }
        }
      }
    },
    "text.resume.extraRoundsNeedStage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "--extra-rounds needs --from review or --from fix: a restart from ship starts the rounds over."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "--extra-rounds necesita --from review o --from fix: un reinicio desde ship empieza las rondas de nuevo."
          }
        }
      }
    },
    "text.resume.noPullRequest": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The epic has no pull request yet, so it can only be restarted from ship."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El epic aún no tiene pull request, así que solo se puede reiniciar desde ship."
          }
        }
      }
    },
    "text.resume.notStopped": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The epic is not stopped"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El epic no está detenido"
          }
        }
      }
    },
    "text.resume.optionUnknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That account is not declared in providers.json. Use a name declared there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa cuenta no está declarada en providers.json. Usa un nombre declarado allí."
          }
        }
      }
    },
    "text.resume.pullRequestHeadChanged": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The pull request has a different head than the one Carrier saved, so nothing was changed. Restart it with --from review to review the new head, or from ship to start over."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pull request tiene un head distinto del que Carrier guardó, así que no se cambió nada. Reiníciala con --from review para revisar el nuevo head, o desde ship para empezar de nuevo."
          }
        }
      }
    },
    "text.resume.pullRequestNotOpen": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The epic's pull request is not open any more, so nothing was changed. Restart it from ship, or reopen the pull request."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pull request del epic ya no está abierta, así que no se cambió nada. Reinícialo desde ship, o reabre la pull request."
          }
        }
      }
    },
    "text.resume.roleUnknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The epic does not have that reviewer or lead. Name only the roles its configuration has."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El epic no tiene ese revisor ni ese líder. Nombra solo los roles que tiene su configuración."
          }
        }
      }
    },
