    "sessionsSettingsNewSessions": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New sessions"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesiones nuevas"
          }
        }
      }
    },
    "sessionsSettingsNewSessionsFooter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A new worktree is offered only for a git repository. The message box and the new session screen still change these for that one session. Remote fetches the branch first and falls back to the local one when it cannot be reached."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un worktree nuevo solo se ofrece para un repositorio git. El cuadro de mensaje y la pantalla de nueva sesión siguen cambiando esto para esa sesión. Remoto trae primero la rama y recurre a la local cuando no se puede llegar a él."
          }
        }
      }
    },
