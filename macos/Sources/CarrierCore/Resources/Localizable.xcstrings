          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tampoco está en el PATH de tu shell, que se acaba de leer de nuevo. Instálalo, o añade su carpeta al PATH de tu shell, y vuelve a iniciar."
          }
        }
      }
    },
