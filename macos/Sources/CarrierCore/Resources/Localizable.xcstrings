      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A child of this session is waiting for %#@count@; stop %#@count2@ first, then archive the session"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "a background task"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "background tasks"
                    }
                  }
                }
