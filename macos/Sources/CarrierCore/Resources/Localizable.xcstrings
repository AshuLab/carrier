    },
    "text.recover.nothingToRecover": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The epic is in a state a recovery does not move (a retry or the next check takes it from here), so nothing was changed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El epic está en un estado que una recuperación no mueve (un reintento o la próxima comprobación lo toma desde aquí), así que no se cambió nada."
          }
        }
      }
