    "chatCompactionDetail.auto %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The context filled up, so %1$@ summarized the earlier conversation and went on. The messages above stay here to read."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El contexto se llenó, así que %1$@ resumió la conversación anterior y siguió. Los mensajes de arriba se quedan aquí para leerlos."
          }
        }
      }
    },
    "chatCompactionDetail.autoTook %@ %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The context filled up, so %1$@ summarized the earlier conversation and went on. The messages above stay here to read. Took %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El contexto se llenó, así que %1$@ resumió la conversación anterior y siguió. Los mensajes de arriba se quedan aquí para leerlos. Tardó %2$@."
          }
        }
      }
    },
    "chatCompactionDetail.manual %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ summarized the earlier conversation to free space. The messages above stay here to read; from now on it works from the summary."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ resumió la conversación anterior para liberar espacio. Los mensajes de arriba se quedan aquí para leerlos; a partir de ahora trabaja desde el resumen."
          }
        }
      }
    },
    "chatCompactionDetail.manualTook %@ %@": {
