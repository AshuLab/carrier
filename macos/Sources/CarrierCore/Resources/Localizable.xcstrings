    "dictationExplainMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To paste what you say into the app you are in, Carrier needs to see which field has the cursor, and to press ⌘V for you. It never reads what is in the fields, and it does not paste into password fields. Without it, the text goes on the clipboard instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para pegar lo que dices en la app en la que estás, Carrier necesita ver qué campo tiene el cursor y pulsar ⌘V por ti. Nunca lee lo que hay en los campos y no pega en campos de contraseña. Sin ella, el texto va al portapapeles."
          }
        }
      }
    },
    "dictationExplainNotNow": {
      "extractionState": "manual",
