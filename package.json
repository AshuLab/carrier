{
  "name": "@ashulab/carrier",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": "26.x",
    "pnpm": "12.x"
  },
  "bin": {
    "carrier": "./dist/cli/main.js"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp -r src/storage/migrations dist/storage/migrations && chmod +x dist/cli/main.js",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@ashulab/universal-logger": "^0.1.1",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "description": "Autonomous epic orchestrator: ships and reviews Solve epics with AI agents on your machine.",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "Diego Ghersi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AshuLab/carrier.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
