    "aboutRowDelayDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waits this long after a release before offering it by itself, so a new version is tried by others first. Check now ignores it"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Espera este tiempo tras una versión antes de ofrecerla sola, para que otros prueben antes la nueva. Buscar ahora lo ignora"
          }
        }
      }
    },
