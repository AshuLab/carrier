                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "them"
                    }
                  }
                }
              }
            }
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una hija de esta sesión espera %#@count@; detén %#@count2@ primero y luego archiva la sesión"
